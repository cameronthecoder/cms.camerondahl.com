# Copy this file to .env and fill in real values. .env is gitignored — it
# should never be committed.
#
# Used in both dev and production. Locally this file just sits in the
# project root. In production (a plain .env on disk, not baked into any
# image), python-dotenv loads it as a fallback — a real environment variable
# set some other way (e.g. systemd's EnvironmentFile=) always takes
# precedence over the .env value.

# Which settings file to use. Points at a module in camdahl_cms/settings/.
# Local dev: camdahl_cms.settings.dev
# Production: camdahl_cms.settings.production (this is also the Docker image default)
DJANGO_SETTINGS_MODULE=camdahl_cms.settings.dev

# django.core.management.utils.get_random_secret_key() generates a good value.
# Required in production; dev.py falls back to an insecure dev-only key if unset.
SECRET_KEY=

# "True" or "False". Defaults to True in dev, False in production.
DEBUG=

# Comma-separated list of allowed hostnames, e.g. camerondahl.com,www.camerondahl.com
# Required in production; defaults to "*" in dev.
ALLOWED_HOSTS=

# Comma-separated list of trusted origins for CSRF (needs scheme), e.g.
# https://camerondahl.com,https://www.camerondahl.com
# Optional; only used in production.
CSRF_TRUSTED_ORIGINS=

# postgres://user:password@host:port/dbname
# Required in production. If unset locally, dev.py falls back to a local
# SQLite file (db.sqlite3) automatically — set this only if you want to
# develop against Postgres locally too.
DATABASE_URL=

# Email
# In dev, emails print to the console unless EMAIL_BACKEND is overridden.
# In production, setting EMAIL_HOST switches from console output to real
# SMTP delivery automatically.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Who gets emailed on unhandled server errors (500s) in production. Only
# fires when DEBUG=False, so this is a no-op in dev regardless.
# Comma-separated emails, or "Name:email" pairs, e.g. "Cam:cam@camerondahl.com"
ADMINS=
